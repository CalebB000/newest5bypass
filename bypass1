local function fixVisuals()
    if not getgenv().DNS["FixVisuals"]["Enabled"] then return end
    
    -- Remove blood screen and damage indicator every frame
    table.insert(DNS_Connections, rs.Heartbeat:Connect(function()
        pcall(function()
            local playerGui = lplr:FindFirstChild("PlayerGui")
            if playerGui then
                local mainGui = playerGui:FindFirstChild("MainScreenGui")
                if mainGui then
                    -- Remove blood screen
                    local bloodScreen = mainGui:FindFirstChild("BloodScreen2")
                    if bloodScreen then pcall(function() bloodScreen:Destroy() end) end
                    
                    -- Remove damage indicator
                    local dmgIndicator = mainGui:FindFirstChild("DamageIndicator")
                    if dmgIndicator then pcall(function() dmgIndicator:Destroy() end) end
                end
            end
        end)
    end))
    
    -- Remove blood particles from all players
    table.insert(DNS_Connections, rs.Heartbeat:Connect(function()
        pcall(function()
            for _, player in ipairs(game:GetService("Players"):GetPlayers()) do
                if player.Character then
                    local hrp = player.Character:FindFirstChild("HumanoidRootPart")
                    if hrp then
                        -- Remove blood particle
                        local bloodParticle = hrp:FindFirstChild("BloodParticle")
                        if bloodParticle then pcall(function() bloodParticle:Destroy() end) end
                    end
                end
            end
        end)
    end))
    
    -- Hook into MainScreenGui to catch BloodScreen2 as it's created
    table.insert(DNS_Connections, rs.Heartbeat:Connect(function()
        pcall(function()
            local playerGui = lplr:FindFirstChild("PlayerGui")
            if playerGui then
                local mainGui = playerGui:FindFirstChild("MainScreenGui")
                if mainGui and not mainGui:FindFirstChild("_BloodHooked") then
                    -- Add marker so we don't rehook
                    local marker = Instance.new("BoolValue")
                    marker.Name = "_BloodHooked"
                    marker.Parent = mainGui
                    
                    -- Hook child added
                    table.insert(DNS_Connections, mainGui.ChildAdded:Connect(function(child)
                        if child.Name == "BloodScreen2" or child.Name == "DamageIndicator" then
                            task.wait(0.001)
                            pcall(function() child:Destroy() end)
                        end
                    end))
                end
            end
        end)
    end))
end

