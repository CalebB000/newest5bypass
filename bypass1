local fov_throttle = 0

local function UpdateCachedAim()
    CachedAimPart = nil
    CachedAimPosition = nil
    
    if macro_mode and not ik_active then return end
    
    if not getgenv().DNS["Silent"]["Enabled"] then return end
    if not getgenv().DNS["Silent"]["Main"]["Enabled"] then return end
    
    fov_throttle = (fov_throttle + 1) % 2
    
    if fov_throttle == 0 then
        SilentTarget = GetClosestPlayerInFOV()
    end
    
    if not SilentTarget then return end
    if not SilentTarget.Character then return end
    
    if not IsAlive(SilentTarget) then return end
    
    if not macro_mode then
        if not DoWallCheck(SilentTarget) then return end
    end
    
    CachedAimPart = GetSilentAimPart(SilentTarget)
    if CachedAimPart then
        CachedAimPosition = CachedAimPart.Position
    end
end

