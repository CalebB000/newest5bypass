if cfg_misc()["InstantKill"]["Enabled"] then
    local ik_cooldown = 0
    local gun_sequence = {"[Double-Barrel SG]", "[TacticalShotgun]", "[Double-Barrel SG]", "[TacticalShotgun]"}
    local gun_index = 1
    local last_shot_time = 0
    local shots_fired = 0
    local ik_executing = false
    
    -- Reset on respawn
    table.insert(DNS_Connections, lplr.CharacterAdded:Connect(function(char)
        task.wait(0.1)
        ik_cooldown = 0
        ik_executing = false
        ik_active = false
        gun_index = 1
        last_shot_time = 0
        shots_fired = 0
        SilentTarget = nil
        CachedAimPart = nil
        CachedAimPosition = nil
    end))
    
    table.insert(DNS_Connections, uis.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then return end
        if input.UserInputType == Enum.UserInputType.MouseButton3 then
            if ik_executing or ik_cooldown > 0 then return end
            
            -- Force update aim to get fresh target
            UpdateCachedAim()
            
            -- CHECK: Must have a LIVING target in FOV to execute
            if not SilentTarget or not SilentTarget.Character then return end
            if not IsAlive(SilentTarget) then return end  -- Dead/K.O check
            
            local lhrp = lplr.Character and lplr.Character:FindFirstChild("HumanoidRootPart")
            local thrp = SilentTarget.Character:FindFirstChild("HumanoidRootPart")
            if not lhrp or not thrp then return end
            
            -- Check if target is in FOV
            local fov_config = getgenv().DNS["Silent"]["FOV"]
            local fov_radius = fov_config["Radius"]
            local screen_pos = c:WorldToViewportPoint(thrp.Position)
            local mouse_pos = uis:GetMouseLocation()
            local dist_to_mouse = (Vector2.new(screen_pos.X, screen_pos.Y) - mouse_pos).Magnitude
            
            if dist_to_mouse > fov_radius then return end  -- Target not in FOV, don't execute
            
            -- Target is ALIVE and in FOV, execute combo
            ik_active = true
            ik_executing = true
            gun_index = 1
            last_shot_time = 0
            shots_fired = 0
            
            local backpack = lplr:FindFirstChild("Backpack")
            if backpack then
                local knife = lplr.Character:FindFirstChild("[Knife]")
                if knife then
                    pcall(function() knife.Parent = backpack end)
                end
            end
        end
    end))
    
    table.insert(DNS_Connections, rs.Heartbeat:Connect(function()
        -- Always decrement cooldown first, regardless of ik_active state
        if ik_cooldown > 0 then
            ik_cooldown = ik_cooldown - 1
        end
        
        if last_shot_time > 0 then
            last_shot_time = last_shot_time + 1
            if last_shot_time > 15 and cfg_misc()["InstantKill"]["PutAwayAfterShot"] then
                local backpack = lplr:FindFirstChild("Backpack")
                if backpack and lplr.Character then
                    local db = lplr.Character:FindFirstChild("[Double-Barrel SG]")
                    local tac = lplr.Character:FindFirstChild("[TacticalShotgun]")
                    local knife = lplr.Character:FindFirstChild("[Knife]")
                    if db then pcall(function() db.Parent = backpack end) end
                    if tac then pcall(function() tac.Parent = backpack end) end
                    if knife then pcall(function() knife.Parent = backpack end) end
                end
                last_shot_time = 0
                ik_active = false
                ik_executing = false
            end
        end
        
        if not ik_active then return end
        if not lplr or not lplr.Character then return end
        
        if shots_fired >= 2 then
            ik_active = false
            ik_executing = false
            ik_cooldown = 10
            return
        end
        
        local closest_player = nil
        local closest_dist = math.huge
        local mousePos = uis:GetMouseLocation()
        
        for _, player in pairs(game:GetService("Players"):GetPlayers()) do
            if player == lplr then continue end
            if not player.Character or not player.Character:FindFirstChild("HumanoidRootPart") then continue end
            if not IsAlive(player) then continue end  -- Skip dead/K.O players
            
            local screenPos = c:WorldToViewportPoint(player.Character.HumanoidRootPart.Position)
            if screenPos.Z <= 0 then continue end
            
            local cursor_dist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
            if cursor_dist < closest_dist then
                closest_dist = cursor_dist
                closest_player = player
            end
        end
        
        if not closest_player then return end
        
        local gun_name = gun_sequence[gun_index]
        local backpack = lplr:FindFirstChild("Backpack")
        if not backpack then return end
        
        local gun_in_char = lplr.Character:FindFirstChild(gun_name)
        if gun_in_char then
            pcall(function() gun_in_char.Parent = backpack end)
        end
        
        local gun = backpack:FindFirstChild(gun_name)
        if gun then
            pcall(function() gun.Parent = lplr.Character end)
            pcall(function() gun:Activate() end)
            last_shot_time = 1
            shots_fired = shots_fired + 1
            ik_cooldown = 5
            gun_index = gun_index + 1
            if gun_index > #gun_sequence then gun_index = 1 end
        end
    end))
end

-- Extended Hitbox - FOV Based Targeting (Non-Revolver Only)
if getgenv().DNS["ExtendedHitbox"]["Enabled"] then
    local visualBox = nil
    local trackedHitboxes = {}  -- Track hitboxes for each player
    
    table.insert(DNS_Connections, rs.RenderStepped:Connect(function()
        if not getgenv().DNS["ExtendedHitbox"]["Enabled"] then return end
        if IsRevolverEquipped() then return end
        
        -- Create visual box on first run
        if not visualBox or not visualBox.Parent then
            visualBox = Instance.new("Part")
            visualBox.Name = "TargetingBox"
            visualBox.Shape = Enum.PartType.Block
            visualBox.Size = getgenv().DNS["ExtendedHitbox"]["VisualBoxSize"]
            visualBox.Color = Color3.fromRGB(128, 128, 128)  -- Grey
            visualBox.Material = Enum.Material.Neon
            visualBox.CanCollide = false
            visualBox.CanQuery = false
            visualBox.Transparency = 0.7
            visualBox.Parent = workspace
        end
        
        -- Find closest player to CURSOR in FOV (GetClosestPlayerInFOV already filters dead/K.O via IsAlive)
        local closestPlayer = GetClosestPlayerInFOV()
        
        -- Must be within 78 studs
        if closestPlayer and closestPlayer.Character then
            local playerHRP = lplr.Character and lplr.Character:FindFirstChild("HumanoidRootPart")
            local targetHRP = closestPlayer.Character:FindFirstChild("HumanoidRootPart")
            if playerHRP and targetHRP then
                local distToPlayer = (targetHRP.Position - playerHRP.Position).Magnitude
                if distToPlayer > getgenv().DNS["ExtendedHitbox"]["Range"] then
                    closestPlayer = nil
                end
            end
        end
        
        -- Apply hitbox only to closest player
        if closestPlayer and closestPlayer.Character then
            closestPlayerRef = closestPlayer  -- Update beam extension reference
            local targetHRP = closestPlayer.Character:FindFirstChild("HumanoidRootPart")
            if targetHRP then
                -- Check distance to closest player
                local playerHRP = lplr.Character and lplr.Character:FindFirstChild("HumanoidRootPart")
                local distToClosest = playerHRP and (targetHRP.Position - playerHRP.Position).Magnitude or math.huge
                
                -- Check if too close (only if CloseDisableEnabled is true)
                local isTooClose = false
                if getgenv().DNS["ExtendedHitbox"]["CloseDisableEnabled"] then
                    isTooClose = distToClosest <= getgenv().DNS["ExtendedHitbox"]["CloseDisableRange"]
                end
                
                -- Only expand if not too close
                if not isTooClose then
                    -- Use silent aim's wall check
                    if DoWallCheck(closestPlayer) then
                        -- Not behind wall - expand hitbox
                        targetHRP.Size = getgenv().DNS["ExtendedHitbox"]["HitboxSize"]
                        targetHRP.CanCollide = false
                        targetHRP.TopSurface = Enum.SurfaceType.Smooth
                        targetHRP.BottomSurface = Enum.SurfaceType.Smooth
                        
                        -- Add to noclip collision group so bullets pass through
                        pcall(function()
                            PhysicsService:AddCollisionGroup("Noclip", targetHRP)
                        end)
                        
                        if getgenv().DNS["ExtendedHitbox"]["ShowHitbox"] then
                            targetHRP.Transparency = 0.7
                            targetHRP.Color = Color3.fromRGB(128, 128, 128)
                            targetHRP.Material = Enum.Material.Neon
                        else
                            targetHRP.Transparency = 1
                        end
                        
                        trackedHitboxes[closestPlayer] = true
                    else
                        -- Behind wall - disable
                        if trackedHitboxes[closestPlayer] then
                            targetHRP.Size = Vector3.new(2, 2, 2)
                            targetHRP.Transparency = 1
                            targetHRP.CanCollide = true
                            pcall(function() PhysicsService:RemoveCollisionGroup("Noclip", targetHRP) end)
                            trackedHitboxes[closestPlayer] = nil
                        end
                    end
                else
                    -- Too close (if CloseDisableEnabled) - disable
                    if trackedHitboxes[closestPlayer] then
                        targetHRP.Size = Vector3.new(2, 2, 2)
                        targetHRP.Transparency = 1
                        targetHRP.CanCollide = true
                        pcall(function() PhysicsService:RemoveCollisionGroup("Noclip", targetHRP) end)
                        trackedHitboxes[closestPlayer] = nil
                    end
                end
            end
            
            -- Disable hitboxes for all other players (except dead/K.O)
            for _, player in pairs(game:GetService("Players"):GetPlayers()) do
                if player ~= lplr and player.Character and player ~= closestPlayer then
                    -- Skip dead/K.O players completely
                    if not IsAlive(player) then continue end
                    
                    local targetHRP = player.Character:FindFirstChild("HumanoidRootPart")
                    if targetHRP and trackedHitboxes[player] then
                        targetHRP.Size = Vector3.new(2, 2, 2)  -- Reset to normal
                        -- Don't touch collision groups - leave them in Default so bullets hit them
                        trackedHitboxes[player] = nil
                    end
                end
            end
        else
            -- No target - reset ALL tracked hitboxes to normal collision
            closestPlayerRef = nil  -- Clear beam extension reference
            for player, wasTracked in pairs(trackedHitboxes) do
                if wasTracked and player.Character and IsAlive(player) then
                    local targetHRP = player.Character:FindFirstChild("HumanoidRootPart")
                    if targetHRP then
                        -- Reset size only - leave collision groups alone
                        targetHRP.Size = Vector3.new(2, 2, 2)
                        targetHRP.Transparency = 1
                        -- Remove from Noclip so they collide normally again
                        pcall(function() PhysicsService:RemoveCollisionGroup("Noclip", targetHRP) end)
                    end
                end
            end
            trackedHitboxes = {}
            if visualBox then visualBox.Transparency = 1 end
        end
    end))
end

