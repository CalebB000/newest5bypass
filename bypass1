if getgenv().DNS["SpreadMod"]["Enabled"] then
    local math_random_old
    math_random_old = hookfunction(math.random, newcclosure(function(...)
        if checkcaller() then return math_random_old(...) end
        local spread = cfg_spread()
        if spread and spread["Enabled"] then
            local args = {...}
            local a1, a2 = args[1], args[2]
            if (#args == 0) or (a1 == -0.05 and a2 == 0.05) or (a1 == -0.1) or (a1 == -0.05) then
                return math_random_old(...) * (spread["Amount"] / 100)
            end
        end
        return math_random_old(...)
    end))
    getgenv().DNS_OldRandom = math_random_old
end


if gun_handler_active then
    local orig_shoot = gun_handler.shoot
    local ClientBulletHooked = false
    
    
    table.insert(DNS_Connections, game:GetService("RunService").Heartbeat:Connect(function()
        local cb_enabled = getgenv().DNS["Silent"]["ClientBullet"]["Enabled"]
        local cb_mode = getgenv().DNS["Silent"]["ClientBullet"]["Mode"]
        
        
        if macro_mode then
            cb_enabled = false
        end
        
        
        if cb_enabled and not ClientBulletHooked then
            gun_handler.shoot = function(args)
                UpdateCachedAim()
                
                local results = {orig_shoot(args)}
                
                -- Check if revolver is equipped
                local isRevolver = IsRevolverEquipped()
                
                -- Calculate distance to target
                local distance = 0
                if SilentTarget and SilentTarget.Character then
                    local lhrp = lplr.Character and lplr.Character:FindFirstChild("HumanoidRootPart")
                    local thrp = SilentTarget.Character:FindFirstChild("HumanoidRootPart")
                    if lhrp and thrp then
                        distance = (thrp.Position - lhrp.Position).Magnitude
                    end
                end
                
                if CachedAimPart then
                    -- REVOLVER: Full ClientBullet redirect with 263 stud limit
                    if isRevolver and CachedAimPosition and distance <= 263 then
                        local muz = args.ForcedOrigin
                            or (args.Handle and args.Handle:FindFirstChild("Muzzle") and args.Handle.Muzzle.WorldPosition)
                            or c.CFrame.Position
                        
                        results[1] = CachedAimPosition
                        results[2] = CachedAimPart
                        results[3] = (muz - CachedAimPosition).Unit
                    elseif not isRevolver and distance <= 9999999 then
                        -- OTHER GUNS: Only redirect results[2] (invisible head hit) within 78 studs
                        results[2] = CachedAimPart  -- Force hit guaranteed
                    end
                end
                
                return table.unpack(results)
            end
            
            ClientBulletHooked = true
        elseif not cb_enabled and ClientBulletHooked then
            gun_handler.shoot = orig_shoot
            ClientBulletHooked = false
        end
    end))
    
    getgenv().DNS_GunHandler = gun_handler
    getgenv().DNS_GunHandlerOriginal = orig_shoot
 
    if gun_handler.getAim then
        local orig_get_aim = gun_handler.getAim
        gun_handler.getAim = function(p0, p1)
            local sc = getgenv().DNS["Silent"]
            if not sc["Enabled"] or not sc["Main"]["Enabled"] then return orig_get_aim(p0,p1) end
            
            if not CachedAimPosition then return orig_get_aim(p0,p1) end
            
            -- Revolver: return normal aim (for full ClientBullet)
            if IsRevolverEquipped() then return orig_get_aim(p0,p1) end
            
            -- Other guns: redirect aim (invisible head hit method)
            local dir = CachedAimPosition - p0
            return dir.Unit, dir.Magnitude
        end
    end
end

