-- EXTEND BEAMS - Only to active target
local beamDefaults = {}
local closestPlayerRef = nil  -- Reference to current target

local function extendBeams()
    table.insert(DNS_Connections, workspace.Ignored.Siren.Radius.ChildAdded:Connect(function(part)
        if part.Name == "BULLET_RAYS" then
            task.spawn(function()
                task.wait(0.001)
                local beam = part:FindFirstChild("NewGunBeam")
                if beam and beam:IsA("Beam") and beam.Attachment0 and beam.Attachment1 then
                    -- Only modify if we have an active target with expanded hitbox
                    if closestPlayerRef and closestPlayerRef.Character then
                        local targetHRP = closestPlayerRef.Character:FindFirstChild("HumanoidRootPart")
                        if targetHRP and targetHRP.Size == getgenv().DNS["ExtendedHitbox"]["HitboxSize"] then
                            beam.Width0 = 0.03
                            beam.Width1 = 0.1
                            
                            local att0 = beam.Attachment0
                            local att1 = beam.Attachment1
                            
                            local beamKey = tostring(part)
                            if not beamDefaults[beamKey] then
                                beamDefaults[beamKey] = att1.Position
                            end
                            
                            local startPos = att0.WorldPosition
                            local distToTarget = (targetHRP.Position - startPos).Magnitude
                            
                            if distToTarget <= 78 then
                                att1.Position = Vector3.new(0, 0, -distToTarget)
                            else
                                att1.Position = beamDefaults[beamKey]
                            end
                        end
                    end
                    -- Don't touch beam if no active target - leave it completely alone
                end
            end)
        end
    end))
end

extendBeams()

