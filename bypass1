local function disableHitboxExpansion(player)
    if not player or not player.Character then return end
    local targetPart = player.Character:FindFirstChild(getgenv().DNS["ExtendedHitbox"]["TargetPart"])
    if targetPart then
        targetPart.Size = Vector3.new(2, 2, 2)
        targetPart.Transparency = 1  -- Reset transparency to hide grey box
        trackedHitboxes[player] = nil  -- Remove from tracked
        pcall(function()
            PhysicsService:RemoveCollisionGroup("Noclip")
            PhysicsService:CreateCollisionGroup("Noclip")
            PhysicsService:CollisionGroupSetCollidable("Noclip", "Noclip", false)
        end)
    end
end

local function expandHitbox(player)
    if not player or not player.Character then return end
    local hum = player.Character:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return end
    
    local be = player.Character:FindFirstChild("BodyEffects")
    if be then
        if be:FindFirstChild("K.O") and be["K.O"].Value == true then return end
        if be:FindFirstChild("Dead") and be["Dead"].Value == true then return end
    end
    
    local targetPart = player.Character:FindFirstChild(getgenv().DNS["ExtendedHitbox"]["TargetPart"])
    if targetPart and targetPart:IsA("BasePart") then
        pcall(function() PhysicsService:AddCollisionGroup("Hitboxes", targetPart) end)
        targetPart.Size = getgenv().DNS["ExtendedHitbox"]["HitboxSize"]
        targetPart.Transparency = 1
        targetPart.CanCollide = false
    end
end

local function monitorPlayerStatus(player)
    if player == lplr then return end
    
    table.insert(DNS_Connections, player.CharacterAdded:Connect(function()
        task.wait(0.1)
        expandHitbox(player)
    end))
    
    local function watchStatus()
        if not player.Character then return end
        local bodyEffects = player.Character:FindFirstChild("BodyEffects")
        if bodyEffects then
            local koValue = bodyEffects:FindFirstChild("K.O")
            local deadValue = bodyEffects:FindFirstChild("Dead")
            
            if koValue then
                table.insert(DNS_Connections, koValue.Changed:Connect(function()
                    if koValue.Value == true then
                        disableHitboxExpansion(player)
                    else
                        expandHitbox(player)
                    end
                end))
            end
            
            if deadValue then
                table.insert(DNS_Connections, deadValue.Changed:Connect(function()
                    if deadValue.Value == true then
                        disableHitboxExpansion(player)
                    end
                end))
            end
        end
    end
    
    watchStatus()
end

